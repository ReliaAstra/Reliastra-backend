# =============================================================================
# Reliastra Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in production values.
# For ZevCloud/Railway/Render deployments, set these as runtime environment variables.
# =============================================================================

# ── CORE SERVICES (Required) ──────────────────────────────────────────────────
# PostgreSQL connection URL with asyncpg driver (REQUIRED)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reliastra

# PostgreSQL SSL mode — set to 'require' for external databases (Supabase, Neon, RDS, etc.)
# Leave empty for local development databases.
DATABASE_SSL_MODE=

# Redis connection URL (REQUIRED for rate limiting, idempotency, Celery, OAuth state)
REDIS_URL=redis://localhost:6379/0

# Cryptographic secret key for JWT signing and Fernet encryption (REQUIRED)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-cryptographically-random-32-char-string

# Environment name: development | staging | production
ENVIRONMENT=development

# ── CORS (Required for frontend integration) ───────────────────────────────────
# Must include your frontend URL(s). The default allows local dev only.
# For production: ["https://yourdomain.com", "https://app.yourdomain.com"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── AUTH TOKENS ─────────────────────────────────────────────────────────────
# Access token lifetime in minutes (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── GOOGLE OAUTH ────────────────────────────────────────────────────────────
# Enable Google OAuth authentication (true/false)
GOOGLE_AUTH_ENABLED=false

# Google OAuth 2.0 credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the "Authorized redirect URI" in Google Cloud Console
# Example: https://your-app.com/auth/google/callback
GOOGLE_REDIRECT_URI=

# ── GITHUB OAUTH ─────────────────────────────────────────────────────────────
# Enable GitHub OAuth authentication (true/false)
GITHUB_AUTH_ENABLED=false

# GitHub OAuth App credentials from https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must match the "Authorization callback URL" in GitHub App settings
# Example: https://your-app.com/auth/github/callback
GITHUB_REDIRECT_URI=

# ── FRONTEND URL ──────────────────────────────────────────────────────────────
# Base URL of your frontend application (for email verification & password reset links)
FRONTEND_BASE_URL=http://localhost:3000

# ── PAYSTACK BILLING ──────────────────────────────────────────────────────────
# Paystack secret key (from https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=

# Paystack public key (for payment initialization on frontend)
PAYSTACK_PUBLIC_KEY=

# Paystack API base URL (leave default for production)
PAYSTACK_BASE_URL=https://api.paystack.co

# ── OBJECT STORAGE (Evidence PDF reports) ─────────────────────────────────────
# Supports any S3-compatible provider: MinIO, AWS S3, Supabase Storage, Cloudflare R2, etc.
#
# For Supabase Storage S3:
#   MINIO_ENDPOINT=<project-ref>.storage.supabase.co/storage/v1/s3
#   MINIO_ACCESS_KEY=<your-access-key-id>
#   MINIO_SECRET_KEY=<your-secret-access-key>
#   MINIO_BUCKET=<your-bucket-name>
#   MINIO_USE_SSL=true
#   MINIO_REGION=eu-west-3
#
# For local MinIO (docker-compose):
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=reliastra-evidence
MINIO_USE_SSL=false
MINIO_REGION=

# ── EMAIL / NOTIFICATIONS ─────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@reliastra.com
SMTP_USE_TLS=false

# ── EMAIL VERIFICATION & PASSWORD RESET ────────────────────────────────────
# Email verification token lifetime in minutes (default: 60)
EMAIL_VERIFICATION_EXPIRE_MINUTES=60

# Password reset token lifetime in minutes (default: 15)
PASSWORD_RESET_EXPIRE_MINUTES=15

# ── PARTNER NETWORK & DISTRIBUTION ────────────────────────────────────────────
# Canonical public origin used to build partner referral links.
# Links are always {RELIASTRA_PUBLIC_URL}{PARTNER_REFERRAL_PATH_PREFIX}/{partner_code}
RELIASTRA_PUBLIC_URL=https://reliastra.com
PARTNER_REFERRAL_PATH_PREFIX=/r

# Last-touch attribution window in days (default: 90)
PARTNER_ATTRIBUTION_WINDOW_DAYS=90

# Days a commission stays in `pending` before becoming `payable` (default: 30)
PARTNER_COMMISSION_HOLD_DAYS=30

# Default ISO-4217 currency for partner money. All amounts are integer minor units.
PARTNER_DEFAULT_CURRENCY=USD

# Earning-method commission rates in basis points (1 bps = 0.01%; 2000 = 20%)
PARTNER_RATE_REFER_BPS=2000
PARTNER_RATE_DEPLOY_BPS=3000
PARTNER_RATE_CREATE_BPS=2500
PARTNER_RATE_INTRODUCE_BPS=1500
# Resellers earn wholesale margin, never a platform commission.
PARTNER_RATE_RESELL_BPS=0

# Hard ceiling on combined commission for one payment (5000 bps = 50%)
PARTNER_MAX_TOTAL_COMMISSION_BPS=5000

# Year-1 window (months) for INTRODUCE commissions
PARTNER_INTRODUCE_WINDOW_MONTHS=12

# Minimum payable balance in minor units before payout is allowed (5000 = $50.00)
PARTNER_MIN_PAYOUT_MINOR=5000

# Click dedup window in seconds (default: 1800)
PARTNER_CLICK_DEDUP_WINDOW_SECONDS=1800

# Risk score at/above which commissions are held for manual review (0-100)
PARTNER_FRAUD_REVIEW_SCORE=70

# Auto-approve partner applications (non-production only)
PARTNER_AUTO_APPROVE_APPLICATIONS=false

# ── GEO / MAXMIND ─────────────────────────────────────────────────────────────
# Local GeoLite2 database. Lookups are local + Redis cached; never per-request HTTP.
MAXMIND_DB_PATH=/var/lib/geoip/GeoLite2-City.mmdb
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_CACHE_TTL_SECONDS=86400
