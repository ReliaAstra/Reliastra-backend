# =============================================================================
# Reliastra Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in production values.
# For ZevCloud/Railway/Render deployments, set these as runtime environment variables.
# =============================================================================

# ── CORE SERVICES (Required) ──────────────────────────────────────────────────
# PostgreSQL connection URL with asyncpg driver (REQUIRED)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reliastra

# PostgreSQL SSL mode — set to 'require' for external databases (Supabase, Neon, RDS, etc.)
# Leave empty for local development databases.
DATABASE_SSL_MODE=

# Redis connection URL (REQUIRED for rate limiting, idempotency, Celery)
REDIS_URL=redis://localhost:6379/0

# Cryptographic secret key for JWT signing and Fernet encryption (REQUIRED)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-cryptographically-random-32-char-string

# Environment name: development | staging | production
ENVIRONMENT=development

# ── CORS (Required for frontend integration) ───────────────────────────────────
# Must include your frontend URL(s). The default allows local dev only.
# For production: ["https://yourdomain.com", "https://app.yourdomain.com"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── AUTH TOKENS ─────────────────────────────────────────────────────────────
# Access token lifetime in minutes (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PAYSTACK BILLING ──────────────────────────────────────────────────────────
# Paystack secret key (from https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=

# Paystack public key (for payment initialization on frontend)
PAYSTACK_PUBLIC_KEY=

# Paystack API base URL (leave default for production)
PAYSTACK_BASE_URL=https://api.paystack.co

# ── OBJECT STORAGE (Evidence PDF reports) ─────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=reliastra-evidence
MINIO_USE_SSL=false

# ── EMAIL / NOTIFICATIONS ─────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@reliastra.com
SMTP_USE_TLS=false
