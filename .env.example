POSTGRES_DB=reliastra
POSTGRES_USER=reliastra
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://reliastra:replace-with-a-long-random-password@postgres:5432/reliastra
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-with-random-access-key
MINIO_SECRET_KEY=replace-with-long-random-secret-key
MINIO_BUCKET=reliastra-evidence
MINIO_USE_SSL=false
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@reliastra.com
CORS_ORIGINS=http://localhost:3000
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
