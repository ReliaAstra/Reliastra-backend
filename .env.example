# ===========================================================================
# Reliastra Backend — Environment Configuration Template
# Copy to `.env` and fill in real values. Never commit the real `.env`.
# ===========================================================================

# --- Core / API ---
ENVIRONMENT=development            # development | staging | production
SECRET_KEY=change-me-to-a-cryptographically-random-32-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (asyncpg driver) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reliastra

# --- Redis (rate limiting, idempotency, Celery broker/backend) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
# Comma-separated list of allowed origins (explicit list required when
# CORS_ALLOW_CREDENTIALS=true).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# --- Object Storage (MinIO / S3-compatible) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=reliastra-evidence
MINIO_USE_SSL=false

# --- Email / SMTP ---
SMTP_HOST=localhost
SMTP_PORT=1025                 # 1025 = local MailHog; 587 = STARTTLS; 465 = implicit SSL
SMTP_FROM=noreply@reliastra.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SSL=false

# --- Payment Provider (Paystack is the default provider) ---
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=paystack-webhook-signature-secret
PAYSTACK_CALLBACK_URL=http://localhost:3000/billing/callback

# --- Deprecated legacy (Stripe) — kept only for backward compatibility ---
# STRIPE_WEBHOOK_SECRET=

# --- AI / LLM Provider integration ---
# AI_GENERATION_ENABLED=false   # feature flag for the explain-only AI pipeline
