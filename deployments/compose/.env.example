# Reliastra environment template. Copy to .env (never commit .env).
# All values are validated at startup; required values fail fast.

# ---- Runtime ---------------------------------------------------------------
RELI_ENV=development            # development | test | production
RELI_LOG_LEVEL=info             # debug | info | warn | error

# ---- HTTP API --------------------------------------------------------------
RELI_HTTP_ADDR=:8080
RELI_HTTP_MAX_BODY_BYTES=1048576
RELI_HTTP_TRUST_PROXY_HEADERS=false
RELI_CORS_ALLOWED_ORIGINS=

# ---- Database --------------------------------------------------------------
RELI_DATABASE_URL=postgres://reliastra:password@localhost:5432/reliastra?sslmode=disable
RELI_DATABASE_MAX_CONNS=20
RELI_DATABASE_MIN_CONNS=2
RELI_DATABASE_QUERY_MODE=exec    # exec | simple | cache

# ---- Redis (optional; empty disables distributed rate limiting) ------------
RELI_REDIS_ADDR=
RELI_REDIS_PASSWORD=

# ---- Object storage --------------------------------------------------------
RELI_OBJECT_STORE_BACKEND=filesystem   # s3 | filesystem
RELI_OBJECT_STORE_FS_ROOT=./data/objectstore
# RELI_OBJECT_STORE_BACKEND=s3
# RELI_OBJECT_STORE_ENDPOINT=minio:9000
# RELI_OBJECT_STORE_BUCKET=reliastra-evidence
# RELI_OBJECT_STORE_ACCESS_KEY=
# RELI_OBJECT_STORE_SECRET_KEY=
# RELI_OBJECT_STORE_USE_SSL=false

# ---- Security --------------------------------------------------------------
# 32-byte hex AES-256 master key for secrets at rest. REQUIRED in production.
# Generate with: openssl rand -hex 32
RELI_ENCRYPTION_MASTER_KEY=

# ---- Auth ------------------------------------------------------------------
RELI_AUTH_SESSION_TTL=168h
RELI_AUTH_REGISTER_ENABLED=true

# ---- Processes -------------------------------------------------------------
RELI_SCHEDULER_POLL_INTERVAL=5s
RELI_SCHEDULER_BATCH_SIZE=500
RELI_WORKER_CONCURRENCY=8
RELI_WORKER_REGION_ID=eu-west    # region slug or id this worker observes from
RELI_NOTIFIER_POLL_INTERVAL=2s

# ---- Notifications ---------------------------------------------------------
RELI_SMTP_ENABLED=false
# RELI_SMTP_HOST=smtp.example.com
# RELI_SMTP_PORT=587
# RELI_SMTP_USERNAME=
# RELI_SMTP_PASSWORD=
RELI_SLACK_ENABLED=false

# ---- Plans (limits are config-driven; do not hardcode plans in code) -------
RELI_PLANS_DEFAULT=free
